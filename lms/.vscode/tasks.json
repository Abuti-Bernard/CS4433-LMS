{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "LMS: Build (all sources)",
            "type": "shell",
            "command": "C:/msys64/ucrt64/bin/bash.exe",
            "args": [
                "-lc",
                "bash build.sh"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$gcc"]
        }
    ]
}